\docType{package}
\title{Intuitionistic Fuzzy Statistics Toolkit}
\description{
A comprehensive toolkit for intuitionistic fuzzy sets (Atanassov, 1986),
where each element carries membership \eqn{\mu}, non-membership \eqn{\nu}
and hesitation \eqn{\pi = 1 - \mu - \nu}. Provides constructors and
arithmetic, Xu/Yager aggregation operators, entropy and similarity
measures, fuzzy clustering, compositional inference, and IF-TOPSIS.
}
\references{
Atanassov, K. (1986). Intuitionistic fuzzy sets. \emph{Fuzzy Sets and Systems}, 20(1), 87-96.
Xu, Z. (2007). Intuitionistic fuzzy aggregation operators. \emph{IEEE Trans. Fuzzy Systems}, 15(6), 1179-1187.
Szmidt, E. & Kacprzyk, J. (2000). Distances between intuitionistic fuzzy sets. \emph{Fuzzy Sets and Systems}, 114(3), 505-518.
}
\keyword{internal}
